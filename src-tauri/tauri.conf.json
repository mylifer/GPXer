{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPXer",
  "version": "0.4.2",
  "identifier": "com.mylifer.gpxer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GPXer",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.tile.opentopomap.org https://server.arcgisonline.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.tile.opentopomap.org https://server.arcgisonline.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "GPX görüntüleyici",
    "longDescription": "GPX iz, rota ve nokta dosyalarını harita, istatistik ve yükseklik grafiğiyle görüntüler.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "gpx"
        ],
        "name": "GPX Dosyası",
        "description": "GPS Exchange Format",
        "role": "Viewer",
        "mimeType": "application/gpx+xml"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRDFBRjJENUQ3QzAzMDQKUldRRUEzeGRMYS9SMGorcDNPdVFCbVpjMCt3YlFuOWN0cXNnQmxvUmpCbXJzN0h6OFlUa3hnajUK",
      "endpoints": [
        "https://github.com/mylifer/GPXer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
